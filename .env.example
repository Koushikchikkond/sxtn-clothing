# SXTN Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SERVER-ONLY — never prefix with NEXT_PUBLIC_
# Used only in lib/supabase/admin.ts, webhooks, and admin server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Get from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudflare R2 (Image Storage) ───────────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
# Account ID:  Cloudflare Dashboard → top-right of R2 page
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sxtn-images
# Public URL: Enable in R2 bucket → Settings → Public Access (or custom domain)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
